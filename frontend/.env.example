NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker Compose dev only: lets server-side data fetching reach the "backend"
# container by its service name instead of "localhost" (which inside a
# container means the container itself). Set automatically by
# docker-compose.dev.yml — leave unset when running bare `npm run dev`.
# STRAPI_INTERNAL_URL=http://backend:1337
