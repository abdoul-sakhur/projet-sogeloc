# Used by docker-compose.yml for variable substitution (${POSTGRES_DB}, etc.)
# and to pass build-time args to the frontend image. Copy to `.env` and fill
# in real values before running `docker compose up`. This is separate from
# backend/.env and frontend/.env, which hold the app-level secrets.

POSTGRES_DB=sogeloc
POSTGRES_USER=sogeloc
POSTGRES_PASSWORD=change-me

# Public URLs baked into the frontend build/runtime. In dev, localhost is
# correct since Docker Compose publishes both ports to the host. In
# production, use the real domains (the frontend container reaches Strapi
# through the public domain too, same as the browser — no internal
# Docker networking needed there since everything routes through Nginx).
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000
