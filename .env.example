# Used by docker-compose.yml for variable substitution and to pass
# build-time args to the frontend image. Copy to `.env` before running
# `docker compose up`. Separate from backend/.env and frontend/.env.local,
# which hold the app-level secrets — the database is SQLite (files bind-
# mounted from ./backend/.tmp and ./backend/public/uploads), so no DB
# credentials are needed here.

# Public URLs baked into the frontend build/runtime. In dev, localhost is
# correct since Docker Compose publishes the frontend port to the host. In
# production, use the real domains once DNS/VPS are provisioned.
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000
